# Canonical origin used for canonical URLs, sitemaps, robots.txt and Open Graph.
# Required in production. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Set to "true" only on the production deployment. Any other value forces
# noindex on every page and disallows crawling in robots.txt, so previews and
# staging environments can never be indexed.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional public contact e-mail shown on /contact/. Leave empty to offer GitHub issues only.
NEXT_PUBLIC_CONTACT_EMAIL=
